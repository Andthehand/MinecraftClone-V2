{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "environment": { "PATH": "$penv{VULKAN_SDK}/Bin;$penv{PATH}" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release without ImGui",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MINECRAFT_ENABLE_IMGUI": "OFF" }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows x64 Development with ImGui and debug symbols",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "MINECRAFT_ENABLE_IMGUI": "ON" }
    },
    {
      "name": "windows-profile",
      "displayName": "Windows x64 Development with Tracy",
      "inherits": "windows-dev",
      "cacheVariables": {
        "MINECRAFT_ENABLE_TRACY": "ON",
        "TRACY_NO_CODE_TRANSFER": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release", "targets": ["MinecraftClone"] },
    { "name": "windows-dev", "configurePreset": "windows-dev", "targets": ["MinecraftClone"] },
    { "name": "windows-profile", "configurePreset": "windows-profile", "targets": ["MinecraftClone"] }
  ]
}
